# ════════════════════════════════════════════════════════════════
# Variables de entorno nuevas — agregar a .env.local / Vercel
# ════════════════════════════════════════════════════════════════

# ── OCA e-Pak ────────────────────────────────────────────────────
# Credenciales de tu cuenta OCA
OCA_USUARIO=tu_email@empresa.com
OCA_PASSWORD=tu_password_oca

# CUIT de tu empresa sin guiones
OCA_CUIT_REMITENTE=20123456789

# Número de cuenta OCA que te asignan al dar de alta
OCA_NUMERO_CUENTA=123456

# Operativa para envíos puerta a puerta (OCA te da el código)
OCA_OPERATIVA_ENVIO=77000

# Operativa puerta a sucursal (opcional)
OCA_OPERATIVA_SUC=88000

# Centro de imposición (sucursal OCA desde donde despachás)
OCA_CENTRO_IMPOS=0

# Código postal de tu local de despacho (San Fernando del V. de Catamarca)
OCA_CP_ORIGEN=4700

# ═══════════════════════════════════════════════════════════════
# NOTAS DE INTEGRACIÓN OCA
# ═══════════════════════════════════════════════════════════════
#
# 1. ALTA COMO CLIENTE OCA
#    - Ingresá a https://www.oca.com.ar/epak
#    - Completá el formulario de alta para e-commerce
#    - Te asignan: número de cuenta, operativas y credenciales
#
# 2. PRUEBAS
#    - OCA tiene un ambiente de homologación separado.
#    - Para testing, usá el endpoint:
#      https://operaciones.oca.com.ar/epak_test (si está disponible)
#    - O usá datos reales en staging con pedidos de $1
#
# 3. FLUJO EN PRODUCCIÓN
#    a) Cliente hace checkout → pedido se crea en PENDIENTE
#    b) Admin confirma pago → cambia a CONFIRMADO / PREPARANDO
#    c) Admin abre el modal del pedido → OcaPanel → "Generar envío OCA"
#       → Se llama POST /api/oca/envios → OCA devuelve número + etiqueta
#       → Pedido pasa a ENVIADO automáticamente
#    d) Admin imprime la etiqueta y lleva el paquete a OCA
#    e) Cliente puede hacer tracking en /mis-pedidos
#    f) Webhook opcional: si OCA lo soporta, actualizar estado automáticamente
#
# 4. PESO Y DIMENSIONES
#    Por defecto el OcaPanel usa:
#      peso: 1kg, alto: 20cm, ancho: 30cm, largo: 40cm
#    El admin puede ajustarlos antes de generar el envío.
#    Considerá crear una tabla de pesos por categoría de producto.
#
# ═══════════════════════════════════════════════════════════════
